{
  "expo": {
    "name": "HealthySongs",
    "slug": "healthysongs",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "healthysongs",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1413",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "HealthySongs reads your facial expression on the phone to sense how you feel. Frames are never stored or sent anywhere."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1413",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "HealthySongs reads your facial expression on the phone to sense how you feel. Frames are never stored or sent anywhere."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1413",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
